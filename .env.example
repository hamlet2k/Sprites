# Copy to .env.local and fill in from Supabase → Project Settings → API
# IMPORTANT: URL must be the project root only — no /rest/v1/ at the end
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Optional login (email / Google / Discord) is configured in the Supabase dashboard,
# NOT in these frontend env vars. Never put OAuth client secrets in VITE_* keys.
